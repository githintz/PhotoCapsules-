<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6121214"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">
    <ImageView android:id="@+id/w_image" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginEnd="10dp" android:contentDescription="Moon phase" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFC93C" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_line1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF" android:textSize="13sp" />
</LinearLayout>
</LinearLayout>
